---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
import GuideCard from '../components/GuideCard.astro';
import { guides } from '../data/guides';

const terminal = `# Read one secret
ov read ov://Team%20Infra/GitHub/password

# Resolve references into a command's environment; output is masked
ov run --env-file .env.tpl -- ./migrate.sh

# Rotate it
ov rotate ov://Team%20Infra/Deploy/Database/password --generate`;

const ts = `import { Account, MemoryStorage } from "@openvireo/sdk";

const account = await Account.connect({
  issuer: "https://accounts.openvireo.com",
  device: { name: "My script", platform: "cli" },
  storage: new MemoryStorage(),
});
await account.login({ email, password, secretKey });

const [first] = await account.listVaults();
const vault = await account.openVault(first.id);
console.log(vault.read("ov://Personal/GitHub/username"));`;

const cli = `# Sign in once on this machine
ov login --email you@example.com

# Read a field
ov read ov://Personal/GitHub/username

# Fill a template; the output file is mode 0600
ov inject -i config.yml.tpl -o config.yml

# Share an item without a login, once, for a day
ov share ov://Private/Bank --field Password --once --expires 1d`;

const py = `import openvireo as ov
from openvireo.hosts import default_host

client = ov.OvClient(
    ov.ClientConfig(
        device=ov.DeviceInfo(id=None, name="backup script", platform=ov.Platform.CLI),
        offline=False,
        server=None,
    ),
    default_host(),
)`;

const kt = `import com.openvireo.core.*
import com.openvireo.core.hosts.defaultHost

val client = OvClient(
    ClientConfig(DeviceInfo(id = null, name = "backup tool", platform = Platform.CLI), offline = false, server = null),
    defaultHost(cacheDir = Path.of("ov-cache")),
)
val account = signIn(client, "me@example.com", password)`;

const products = [
	{
		title: 'TypeScript SDK',
		summary: 'Accounts, vaults, sharing, sync and service accounts. Browser, Node 20+ and Bun.',
		meta: '@openvireo/sdk',
		href: '/sdk/',
		icon: '<path d="M21 16V8l-9-5-9 5v8l9 5 9-5z"/><path d="M3.3 7L12 12l8.7-5M12 22V12"/>',
	},
	{
		title: 'ov CLI',
		summary: 'Read, inject and rotate secrets from scripts and CI. Signed single binaries, no Node needed.',
		meta: 'ov read · ov run · ov inject',
		href: '/cli/',
		icon: '<path d="M4 17l6-5-6-5M12 19h8"/>',
	},
	{
		title: 'Sync server API',
		summary: 'HTTP routes for vaults, history, devices and events. Self-host it or use the hosted service.',
		meta: '/api/v1/vaults',
		href: '/api/',
		icon: '<path d="M8 3H6a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2 2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h2M16 3h2a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2 2 2 0 0 0-2 2v4a2 2 0 0 1-2 2h-2"/>',
	},
	{
		title: 'Language bindings',
		summary: 'The Rust core for Python, Kotlin and Java, Swift and C++. Same facade, same error codes.',
		meta: 'Python · Kotlin/Java · Swift · C++',
		href: '/bindings/',
		icon: '<path d="M12 2l9 5-9 5-9-5 9-5z"/><path d="M3 12l9 5 9-5M3 17l9 5 9-5"/>',
	},
];
---

<StarlightPage
	frontmatter={{
		title: 'Build on OpenVireo',
		description: 'Build on OpenVireo: the TypeScript SDK, the ov CLI, the sync server API and the Rust core bindings. End-to-end encrypted.',
		template: 'splash',
		tableOfContents: false,
		pagefind: false,
		editUrl: false,
	}}
>
	<div class="ov-home not-content">
		<section class="ov-hero">
			<div class="ov-hero-copy">
				<a class="ov-pill" href="/bindings/">
					<span class="ov-pill-tag">New</span>
					Python and Kotlin bindings for the Rust core
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
				</a>
				<h1 id="_top">Build on vaults the server can’t read.</h1>
				<p class="ov-hero-lead">
					SDKs, the <code>ov</code> CLI and an HTTP API for OpenVireo. Read secrets in CI, script vaults and sharing,
					or run your own sync server. Everything is encrypted on the client.
				</p>
				<div class="ov-actions">
					<a class="ov-btn ov-btn-primary" href="/sdk/">
						Get started
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
					</a>
					<a class="ov-btn ov-btn-secondary" href="/api/reference/">API reference</a>
				</div>
				<div class="ov-install">
					<Code code="npm install @openvireo/sdk" lang="sh" frame="none" />
				</div>
			</div>
			<div class="ov-hero-terminal">
				<Code code={terminal} lang="sh" frame="terminal" title="~/deploy" />
			</div>
		</section>

		<section class="ov-section">
			<div class="ov-section-head">
				<div>
					<p class="ov-eyebrow">Pick your tool</p>
					<h2>One core, four ways in</h2>
				</div>
				<p class="ov-section-note">
					The same Rust core runs in every app, so code you write here works with vaults people use on desktop, web
					and iOS.
				</p>
			</div>
			<div class="ov-products">
				{
					products.map((p) => (
						<a class="ov-product" href={p.href}>
							<span class="ov-product-icon">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
							</span>
							<span class="ov-product-title">{p.title}</span>
							<span class="ov-product-summary">{p.summary}</span>
							<code class="ov-product-meta">{p.meta}</code>
						</a>
					))
				}
			</div>
		</section>

		<section class="ov-band">
			<div class="ov-band-inner">
				<div class="ov-band-copy">
					<p class="ov-eyebrow">First program</p>
					<h2>Read a secret in a few lines</h2>
					<p>
						Sign in, open a vault and read an item by its <code>ov://</code> reference. For automation, use a service
						account: no password, scoped to the vaults it needs.
					</p>
					<div class="ov-links">
						<a href="/sdk/">SDK overview →</a>
						<a href="/sdk/guides/service-accounts/">Service accounts →</a>
						<a href="/sdk/concepts/">Concepts and references →</a>
					</div>
				</div>
				<div class="ov-band-code">
					<Tabs syncKey="lang">
						<TabItem label="TypeScript"><Code code={ts} lang="ts" /></TabItem>
						<TabItem label="ov CLI"><Code code={cli} lang="sh" /></TabItem>
						<TabItem label="Python"><Code code={py} lang="python" /></TabItem>
						<TabItem label="Kotlin"><Code code={kt} lang="kotlin" /></TabItem>
					</Tabs>
				</div>
			</div>
		</section>

		<section class="ov-section">
			<div class="ov-section-head">
				<div>
					<p class="ov-eyebrow">Guides</p>
					<h2>Start from a task</h2>
				</div>
				<a href="/guides/" class="ov-more">All guides →</a>
			</div>
			<div class="ov-guides">
				{guides.slice(0, 6).map((g) => <GuideCard {...g} />)}
			</div>
		</section>

		<section class="ov-section">
			<div class="ov-security">
				<div class="ov-security-copy">
					<h2>Zero knowledge, by design</h2>
					<p>
						The servers only ever receive OPAQUE messages, encrypted .kdbx files, wrapped keysets and sealed keys. Your
						integration gets the same guarantees.
					</p>
					<a href="/sdk/concepts/">What the servers see →</a>
				</div>
				<div class="ov-security-points">
					<div>
						<span class="ov-num">01</span>
						<strong>OPAQUE sign-in</strong>
						<span>The password never leaves the device, not even as a hash.</span>
					</div>
					<div>
						<span class="ov-num">02</span>
						<strong>Client-side encryption</strong>
						<span>Vaults are KDBX files, encrypted before upload and merged locally.</span>
					</div>
					<div>
						<span class="ov-num">03</span>
						<strong>Open source</strong>
						<span>The core and SDK are MIT/Apache-2.0, with signed releases.</span>
					</div>
				</div>
			</div>
		</section>

		<footer class="ov-footer">
			<div>
				<strong>OpenVireo Developer</strong>
				<span>Docs for the SDK, CLI, API and bindings.</span>
			</div>
			<div>
				<strong>Build</strong>
				<a href="/sdk/">TypeScript SDK</a>
				<a href="/cli/">ov CLI</a>
				<a href="/api/">Sync server API</a>
				<a href="/bindings/">Bindings</a>
			</div>
			<div>
				<strong>Resources</strong>
				<a href="/self-hosting/">Self-hosting</a>
				<a href="/sdk/api/">TypeScript API</a>
				<a href="/llms.txt">llms.txt</a>
				<a href="https://openvireo.com/.well-known/security.txt">Security</a>
			</div>
			<div>
				<strong>OpenVireo</strong>
				<a href="https://openvireo.com/">openvireo.com</a>
				<a href="https://github.com/openvireo">GitHub</a>
				<a href="https://openvireo.com/docs/user-guide/">User Guide</a>
			</div>
		</footer>
	</div>
</StarlightPage>

<style>
	/* Splash pages keep Starlight's content width; the home page uses its own. */
	:global(.main-frame .sl-container) {
		max-width: none;
	}
	:global(.main-frame .content-panel) {
		padding: 0;
		border: 0;
	}
	.ov-home {
		--ov-max: 77.5rem;
		color: var(--sl-color-white);
	}
	.ov-home h1,
	.ov-home h2 {
		color: var(--sl-color-white);
		margin: 0;
	}
	.ov-home code:not(pre code) {
		font-family: var(--sl-font-mono);
		font-size: 0.875em;
		color: var(--sl-color-white);
	}
	.ov-home a {
		text-decoration: none;
	}

	/* Hero */
	.ov-hero {
		max-width: var(--ov-max);
		margin: 0 auto;
		padding: 5rem 1.5rem 4.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 3.5rem;
		align-items: center;
	}
	.ov-hero-copy {
		flex: 1 1 28rem;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.ov-pill {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		font-size: 0.8125rem;
		color: var(--sl-color-gray-1);
		border: 1px solid var(--ov-border-strong);
		background: var(--ov-surface-1);
		border-radius: 999px;
		padding: 0.375rem 0.875rem 0.375rem 0.375rem;
	}
	.ov-pill-tag {
		background: var(--ov-accent-tint);
		color: var(--ov-accent-text);
		border-radius: 999px;
		padding: 0.1875rem 0.625rem;
		font-weight: 600;
		font-size: 0.75rem;
	}
	.ov-hero h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		line-height: 1.04;
		letter-spacing: -0.035em;
		font-weight: 700;
	}
	.ov-hero-lead {
		margin: 0;
		font-size: 1.1875rem;
		line-height: 1.6;
		color: var(--sl-color-gray-2);
		max-width: 35rem;
	}
	.ov-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding-top: 0.5rem;
	}
	.ov-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		font-size: 0.9375rem;
		padding: 0.8125rem 1.25rem;
		border-radius: 0.625rem;
		min-height: 2.75rem;
		box-sizing: border-box;
	}
	.ov-btn-primary {
		background: var(--ov-accent);
		color: var(--ov-on-accent);
	}
	.ov-btn-primary:hover {
		filter: brightness(1.1);
	}
	.ov-btn-secondary {
		color: var(--sl-color-white);
		border: 1px solid var(--ov-border-strong);
		background: var(--ov-surface-1);
	}
	.ov-btn-secondary:hover {
		background: var(--ov-surface-2);
	}
	.ov-install {
		align-self: flex-start;
		max-width: 100%;
	}
	.ov-hero-terminal {
		flex: 1 1 28rem;
		min-width: 0;
	}
	.ov-hero-terminal :global(.expressive-code .frame) {
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
	}

	/* Sections */
	.ov-section {
		max-width: var(--ov-max);
		margin: 0 auto;
		padding: 2rem 1.5rem 5rem;
	}
	.ov-section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.75rem;
	}
	.ov-eyebrow {
		margin: 0 0 0.625rem;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ov-accent-text);
	}
	.ov-section h2,
	.ov-band h2 {
		font-size: 2.25rem;
		line-height: 1.15;
		letter-spacing: -0.025em;
		font-weight: 700;
	}
	.ov-section-note {
		margin: 0;
		max-width: 27.5rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}
	.ov-more {
		color: var(--ov-accent-text);
		font-size: 0.9375rem;
	}

	/* Products */
	.ov-products {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
	}
	.ov-product {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
		background: var(--ov-surface-1);
		border: 1px solid var(--ov-border);
		border-radius: 1rem;
		padding: 1.5rem;
		color: var(--sl-color-white);
		transition: border-color 0.15s;
	}
	.ov-product:hover {
		border-color: var(--ov-border-strong);
	}
	.ov-product-icon {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.625rem;
		background: var(--ov-accent-tint);
		color: var(--ov-accent-text);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.ov-product-title {
		font-size: 1.125rem;
		font-weight: 600;
	}
	.ov-product-summary {
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}
	.ov-product-meta {
		margin-top: auto;
		font-size: 0.78125rem !important;
		color: var(--sl-color-gray-1) !important;
	}

	/* First program band */
	.ov-band {
		border-top: 1px solid var(--ov-border-soft);
		border-bottom: 1px solid var(--ov-border-soft);
		background: var(--ov-surface-0);
		margin-bottom: 5rem;
	}
	.ov-band-inner {
		max-width: var(--ov-max);
		margin: 0 auto;
		padding: 5rem 1.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 3.5rem;
		align-items: flex-start;
	}
	.ov-band-copy {
		flex: 1 1 20rem;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 1.125rem;
	}
	.ov-band-copy p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--sl-color-gray-2);
	}
	.ov-band-copy p.ov-eyebrow {
		color: var(--ov-accent-text);
		font-size: 0.8125rem;
	}
	.ov-links {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		padding-top: 0.375rem;
	}
	.ov-links a {
		color: var(--ov-accent-text);
	}
	.ov-band-code {
		flex: 2 1 35rem;
		min-width: 0;
	}

	/* Guides */
	.ov-guides {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
		gap: 1rem;
	}

	/* Security */
	.ov-security {
		border: 1px solid var(--ov-border);
		border-radius: 1.25rem;
		background: var(--ov-surface-1);
		padding: 3rem;
		display: flex;
		flex-wrap: wrap;
		gap: 2.5rem;
	}
	.ov-security-copy {
		flex: 1 1 20rem;
		min-width: 0;
	}
	.ov-security-copy h2 {
		font-size: 1.875rem;
		margin-bottom: 0.875rem;
	}
	.ov-security-copy p {
		margin: 0 0 1.25rem;
		font-size: 0.9375rem;
		line-height: 1.65;
		color: var(--sl-color-gray-2);
	}
	.ov-security-copy a {
		color: var(--ov-accent-text);
	}
	.ov-security-points {
		flex: 2 1 32rem;
		min-width: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: 1.5rem;
	}
	.ov-security-points div {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}
	.ov-security-points strong {
		font-size: 1rem;
		color: var(--sl-color-white);
	}
	.ov-num {
		font-family: var(--sl-font-mono);
		font-size: 0.8125rem;
		color: var(--ov-accent-text) !important;
	}

	/* Footer */
	.ov-footer {
		border-top: 1px solid var(--ov-border-soft);
		max-width: var(--ov-max);
		margin: 0 auto;
		padding: 3rem 1.5rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
		gap: 2rem;
		font-size: 0.875rem;
	}
	.ov-footer div {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}
	.ov-footer span,
	.ov-footer a {
		color: var(--sl-color-gray-2);
		line-height: 1.6;
	}
	.ov-footer a:hover {
		color: var(--sl-color-white);
	}

	@media (max-width: 40rem) {
		.ov-hero {
			padding-top: 3rem;
		}
		.ov-security {
			padding: 1.5rem;
		}
		.ov-section h2,
		.ov-band h2 {
			font-size: 1.75rem;
		}
	}
</style>
