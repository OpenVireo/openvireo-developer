---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';

import versions from '../../data/releases.json';
import { exampleLanguages, repoUrl } from '../data/examples';

// `versions` holds the current openvireo-core and openvireo-sdk releases. `npm run sync` writes them
// from the newest release tag in each repo, so they move with the docs; don't edit them by hand.

// Hero code window. Every sample and install command is from the synced docs: the first program on
// /sdk/, /bindings/python/#install, /cli/ and /cli/github-action/. `label` is shown, `sync` is the
// label the docs' tab groups use, so a language picked here is the one the docs open with.
const samples = [
	{
		id: 'ts',
		label: 'TypeScript',
		sync: 'TypeScript',
		lang: 'ts',
		install: 'npm install @openvireo/sdk',
		prompt: true,
		installHref: '/sdk/#install',
		code: `import { Account, MemoryStorage } from "@openvireo/sdk";

const account = await Account.connect({
  issuer: "https://accounts.openvireo.com",
  device: { name: "My script", platform: "cli" },
  storage: new MemoryStorage(),
});
await account.login({ email, password, secretKey });

const [first] = await account.listVaults();
const vault = await account.openVault(first.id);

console.log(vault.read("ov://Personal/GitHub/username"));`,
	},
	{
		id: 'py',
		label: 'Python',
		sync: 'Python',
		lang: 'python',
		install: `pip install "openvireo==${versions.core}" --find-links https://github.com/openvireo/openvireo-core/releases/expanded_assets/v${versions.core}`,
		prompt: true,
		installHref: '/bindings/python/#install',
		code: `import openvireo as ov
from openvireo.hosts import default_host


async def main(email: str, password: bytes, secret_key: bytes) -> None:
    client = ov.OvClient(
        ov.ClientConfig(
            device=ov.DeviceInfo(id=None, name="My script", platform=ov.Platform.CLI),
            offline=False,
            server=None,
        ),
        default_host(),
    )
    account = await client.connect("https://accounts.openvireo.com")
    await account.login(ov.LoginInput(
        email=email, password=password, secret_key=secret_key,
        totp=None, trust_device=True,
    ))

    vaults = await account.vaults()
    vault = await account.open_vault(vaults[0].id)
    print(vault.read_field("ov://Personal/GitHub/username").decode())`,
	},
	{
		id: 'cli',
		label: 'CLI',
		sync: 'ov CLI',
		lang: 'sh',
		install: `curl -fL https://github.com/OpenVireo/openvireo-core/releases/download/v${versions.core}/ov-${versions.core}-linux-x64.tar.gz | tar -xz`,
		prompt: true,
		installHref: '/cli/#install',
		code: `# Sign in; the Secret Key is asked for the first time only
ov login --email you@example.com

# Read one field by reference
ov read ov://Personal/GitHub/token

# Run a process with secrets from a .env template
ov run --env-file .env.tpl -- npm start

# Fill a template; the output file is mode 0600
ov inject -i config.yml.tpl -o config.yml`,
	},
	{
		id: 'action',
		label: 'GitHub Action',
		sync: 'GitHub Action',
		lang: 'yaml',
		install: `uses: openvireo/openvireo-sdk/packages/github-action@v${versions.sdk}`,
		prompt: false,
		installHref: '/cli/github-action/',
		code: `# .github/workflows/deploy.yml
steps:
  - uses: actions/checkout@v4
  - name: Load secrets
    uses: openvireo/openvireo-sdk/packages/github-action@v${versions.sdk}
    with:
      service-account-token: \${{ secrets.OPENVIREO_SERVICE_ACCOUNT_TOKEN }}
      secrets: |
        NPM_TOKEN=ov://Infra/npm/token
  - run: npm publish   # $NPM_TOKEN is set, masked in the logs`,
	},
];

const langs = [
	{ label: 'TypeScript', href: '/sdk/api/' },
	{ label: 'Python', href: '/reference/python/' },
	{ label: 'Kotlin', href: '/reference/kotlin/' },
	{ label: 'Java', href: '/reference/java/' },
	{ label: 'Swift', href: '/reference/swift/' },
	{ label: 'C++', href: '/reference/cpp/' },
	{ label: 'Rust', href: '/reference/rust/' },
];

const products = [
	{ glyph: '{}', name: 'SDKs', href: '/sdk/', desc: 'Sign in, open vaults and read or write items from your own apps.', meta: '@openvireo/sdk · openvireo (Python)' },
	{ glyph: '>_', name: 'ov CLI', href: '/cli/', desc: 'Read secrets, run commands with secrets in their environment, edit items and create share links.', meta: 'ov read · ov run · ov inject' },
	{ glyph: 'CI', name: 'GitHub Action', href: '/cli/github-action/', desc: 'Load secrets into a workflow with a service account, masked in the logs.', meta: 'service accounts' },
	{ glyph: '⇄', name: 'Connect', href: '/cli/connect/', desc: 'A REST server for one service account, so tools without an SDK can fetch secrets. Kubernetes manifests included.', meta: 'ov connect' },
	{ glyph: 'API', name: 'REST API', href: '/api/', desc: 'The sync server’s HTTP routes, with a machine-readable OpenAPI description.', meta: 'openapi.yaml' },
	{ glyph: '▣', name: 'Sync server', href: '/self-hosting/', desc: 'Self-host the open-source sync server from signed release binaries or a Docker image.', meta: 'C++ · Drogon · SQLite' },
];

const guides = [
	{ title: 'Secrets in GitHub Actions', desc: 'Load secrets into CI with a service account.', tag: 'CI/CD', href: '/cli/github-action/' },
	{ title: 'Your first program', desc: 'Sign in and read a field in seven languages.', tag: 'SDK', href: '/sdk/#a-first-program' },
	{ title: 'ov:// secret references', desc: 'Address any field in any vault with one URI.', tag: 'Concepts', href: '/sdk/concepts/#secret-references' },
	{ title: 'Self-host the sync server', desc: 'Release binaries, Docker, HTTPS and deploying.', tag: 'Self-hosting', href: '/self-hosting/install/' },
	{ title: 'Share links from code', desc: 'Share one item or field, with an expiry, a passcode or a single view.', tag: 'Sharing', href: '/sdk/guides/share-links/' },
	{ title: 'Testing your app', desc: 'Run integration tests against in-memory servers.', tag: 'Testing', href: '/sdk/guides/testing/' },
];
---

<StarlightPage
	frontmatter={{
		title: 'Build on OpenVireo',
		description: 'Build on OpenVireo: SDKs for seven languages, the ov CLI, a GitHub Action and the sync server API. End-to-end encrypted.',
		template: 'splash',
		tableOfContents: false,
		pagefind: false,
		editUrl: false,
	}}
>
	<div class="ov-home not-content">
		<section class="ov-hero">
			<div class="ov-grid-bg" aria-hidden="true"></div>
			<div class="ov-wrap ov-hero-inner">
				<div class="ov-hero-copy">
					<a class="ov-pill" href="/reference/">core v{versions.core} · SDK v{versions.sdk}</a>
					<h1 id="_top">Secrets, without<br /> the secret sauce.</h1>
					<p class="ov-lead">
						Read, write and inject end-to-end encrypted secrets from your code, CI and servers. One open-source Rust
						core, seven languages, zero plaintext on our side.
					</p>
					<div class="ov-actions">
						<a class="ov-btn ov-btn-primary" href="/sdk/">Get started</a>
						<a class="ov-btn ov-btn-secondary" href="/reference/">API reference</a>
					</div>
					<div class="ov-install">
						<div class="ov-install-box">
							<span class="ov-install-prompt" aria-hidden="true" data-install-prompt>$</span>
							<code class="ov-install-cmd" data-install-cmd>{samples[0].install}</code>
							<button type="button" class="ov-copy" data-install-copy aria-label="Copy install command">
								<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
							</button>
						</div>
						<span class="ov-install-foot">
							<span class="ov-copied" role="status" data-install-status></span>
							<a href={samples[0].installHref} data-install-link>Other ways to install →</a>
						</span>
					</div>
				</div>

				<div class="ov-window" data-hero-tabs>
					<div class="ov-window-tabs" role="tablist" aria-label="Language">
						{
							samples.map((s, i) => (
								<button
									type="button"
									role="tab"
									id={`ov-hero-tab-${s.id}`}
									aria-controls={`ov-hero-panel-${s.id}`}
									aria-selected={i === 0 ? 'true' : 'false'}
									tabindex={i === 0 ? 0 : -1}
									data-sync={s.sync}
									data-install={s.install}
									data-install-href={s.installHref}
									data-prompt={s.prompt ? 'true' : 'false'}
								>
									{s.label}
								</button>
							))
						}
					</div>
					{
						samples.map((s, i) => (
							<div
								class="ov-window-panel"
								role="tabpanel"
								id={`ov-hero-panel-${s.id}`}
								aria-labelledby={`ov-hero-tab-${s.id}`}
								hidden={i !== 0}
							>
								<Code code={s.code} lang={s.lang} frame="none" />
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="ov-wrap ov-langs" aria-labelledby="ov-langs-label">
			<span id="ov-langs-label">API reference for</span>
			<ul>
				{langs.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
			</ul>
		</section>

		<section class="ov-wrap ov-langs ov-langs-examples" aria-labelledby="ov-examples-label">
			<a id="ov-examples-label" href="/guides/examples/">Runnable examples in</a>
			<ul>
				{exampleLanguages.map((l) => <li><a href={repoUrl(l)}>{l.label}</a></li>)}
			</ul>
		</section>

		<section class="ov-wrap ov-section">
			<h2>Pick your tool</h2>
			<p class="ov-sub">Everything talks to the same account, vaults and service accounts.</p>
			<div class="ov-products">
				{
					products.map((p) => (
						<a class="ov-card" href={p.href}>
							<span class="ov-glyph" aria-hidden="true">{p.glyph}</span>
							<span class="ov-card-name">{p.name}</span>
							<span class="ov-card-desc">{p.desc}</span>
							<span class="ov-card-meta">{p.meta}</span>
						</a>
					))
				}
			</div>
		</section>

		<section class="ov-arch">
			<div class="ov-wrap ov-arch-inner">
				<div>
					<p class="ov-kicker">// how it works</p>
					<h2>Decrypted in your process. Nowhere else.</h2>
					<p class="ov-sub">
						Every SDK wraps the same Rust core. It does the OPAQUE login, key derivation and KDBX parsing locally,
						then talks to the sync server over your platform’s own HTTP stack.
					</p>
					<a class="ov-more" href="/sdk/concepts/#what-the-servers-see">Read the security model →</a>
				</div>
				<div class="ov-diagram" role="img" aria-label="TypeScript, Python, Swift and JVM apps all call openvireo-core, which does OPAQUE, Argon2 and KDBX locally; only ciphertext goes to the sync server, hosted or self-hosted.">
					<div class="ov-diagram-langs">
						<span>TS</span><span>Python</span><span>Swift</span><span>JVM</span>
					</div>
					<div class="ov-diagram-core">openvireo-core (Rust) · OPAQUE · Argon2 · KDBX</div>
					<div class="ov-diagram-arrow">▼ ciphertext only ▼</div>
					<div class="ov-diagram-server">Sync server · hosted or self-hosted</div>
				</div>
			</div>
		</section>

		<section class="ov-wrap ov-section">
			<div class="ov-section-head">
				<h2>Popular guides</h2>
				<a class="ov-more" href="/guides/">All guides →</a>
			</div>
			<ul class="ov-guides">
				{
					guides.map((g) => (
						<li>
							<a href={g.href}>
								<span>
									<span class="ov-guide-title">{g.title}</span>
									<span class="ov-guide-desc">{g.desc}</span>
								</span>
								<span class="ov-guide-tag">{g.tag}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="ov-wrap ov-cta-wrap">
			<div class="ov-cta">
				<div>
					<h2>Building with an AI agent?</h2>
					<p>Point it at <code>/llms.txt</code>. Every page is also served as Markdown.</p>
				</div>
				<a class="ov-btn ov-btn-secondary" href="/llms.txt">Open llms.txt</a>
			</div>
		</section>

		<footer class="ov-footer">
			<div class="ov-wrap ov-footer-inner">
				<span>© 2026 OpenVireo · SDKs MIT or Apache-2.0</span>
				<nav aria-label="Footer">
					<a href="https://openvireo.com/">openvireo.com</a>
					<a href="https://github.com/openvireo">GitHub</a>
					<a href="https://openvireo.com/docs/user-guide/">User Guide</a>
					<a href="https://openvireo.com/.well-known/security.txt">Security</a>
				</nav>
			</div>
		</footer>
	</div>
</StarlightPage>

<script>
	// Hero code window: tabs switch the sample and the install command. The choice is shared with the docs'
	// tab groups (src/scripts/code-tabs.ts) through the same localStorage key.
	const KEY = 'ov-code-lang';
	const root = document.querySelector<HTMLElement>('[data-hero-tabs]');
	const cmd = document.querySelector<HTMLElement>('[data-install-cmd]');
	const prompt = document.querySelector<HTMLElement>('[data-install-prompt]');
	const link = document.querySelector<HTMLAnchorElement>('[data-install-link]');
	const status = document.querySelector<HTMLElement>('[data-install-status]');
	const copy = document.querySelector<HTMLButtonElement>('[data-install-copy]');

	if (root && cmd && prompt && link && status && copy) {
		const list = root.querySelector<HTMLElement>('[role="tablist"]')!;
		const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

		const select = (tab: HTMLButtonElement, focus = false) => {
			for (const t of tabs) {
				const on = t === tab;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
			}
			cmd.textContent = tab.dataset.install!;
			prompt.hidden = tab.dataset.prompt !== 'true';
			link.href = tab.dataset.installHref!;
			status.textContent = '';
			if (focus) tab.focus();
		};

		try {
			const stored = localStorage.getItem(KEY);
			const match = tabs.find((t) => t.dataset.sync === stored);
			if (match) select(match);
		} catch {}

		const remember = (tab: HTMLButtonElement) => {
			try {
				localStorage.setItem(KEY, tab.dataset.sync!);
			} catch {}
		};

		list.addEventListener('click', (e) => {
			const tab = (e.target as Element).closest<HTMLButtonElement>('[role="tab"]');
			if (!tab) return;
			select(tab);
			remember(tab);
		});
		list.addEventListener('keydown', (e) => {
			const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
			if (i < 0) return;
			const next =
				e.key === 'ArrowRight' ? (i + 1) % tabs.length
				: e.key === 'ArrowLeft' ? (i - 1 + tabs.length) % tabs.length
				: e.key === 'Home' ? 0
				: e.key === 'End' ? tabs.length - 1
				: -1;
			if (next < 0) return;
			e.preventDefault();
			select(tabs[next]!, true);
			remember(tabs[next]!);
		});

		copy.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(cmd.textContent ?? '');
				status.textContent = 'Copied';
			} catch {
				status.textContent = 'Couldn’t copy';
			}
			setTimeout(() => (status.textContent = ''), 2000);
		});
	}
</script>

<style>
	/* The home page draws full-width bands; drop the splash template's container and padding. */
	:global(.main-frame .sl-container) {
		max-width: none;
	}
	:global(.main-frame .content-panel) {
		padding: 0;
		border: 0;
	}

	.ov-home {
		color: var(--sl-color-white);
		font-size: 1rem;
	}
	.ov-home h1,
	.ov-home h2 {
		font-family: var(--ov-font-display);
		color: var(--sl-color-white);
		margin: 0;
	}
	.ov-home a {
